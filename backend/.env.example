# GETVOXLY backend — environment template.
# Copy to .env and fill in real values. Never commit .env.

# development | test | production
NODE_ENV=development

HOST=0.0.0.0
PORT=4000

# PostgreSQL 16 connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/getvoxly

# Required. In production it must be at least 32 characters and must not be a
# known placeholder. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-before-deploying

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# OTP login codes
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Comma-separated list of allowed browser origins.
# A `*.` prefix expands to exactly one label: https://*.getvoxly.ru
CORS_ORIGIN=http://localhost:3000

# Externally reachable base URL of this API. Used to register the bot webhooks;
# it cannot be derived from HOST/PORT because the API sits behind a proxy.
PUBLIC_API_URL=

# Base URL used for links inside e-mails (password reset, welcome).
PUBLIC_APP_URL=https://app.getvoxly.ru

# ---------------------------------------------------------------------------
# Telegram bot that delivers login codes (@GetVoxlybot).
# Optional: without a token the Telegram channel reports itself unavailable
# instead of the API refusing to boot.
# ---------------------------------------------------------------------------
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_BOT_USERNAME=GetVoxlybot
# Verified against the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Telegram MTProto (my.telegram.org -> API development tools).
#
# Not the bot token above: these connect USER accounts through MTProto so the
# CRM can see private conversations with customers. The bot token only delivers
# login codes into the CRM itself. Two different subsystems.
#
# Optional as a pair: without them the Telegram channel answers
# 503 TELEGRAM_MTPROTO_UNAVAILABLE and the rest of the API keeps working.
# Setting only one of the two fails validation at boot — MTProto needs both.
# ---------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---------------------------------------------------------------------------
# Encryption key for channel_accounts.credentials (32 bytes, hex or base64).
#
# Required when TELEGRAM_API_ID is set. A stored MTProto session grants FULL
# access to the user's Telegram account: reading every private chat and sending
# on their behalf. A database dump or a backup would expose it, and RLS does not
# help there — it restricts application queries, not file access.
#
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# MAX bot that delivers login codes (@id505030516451_bot).
# Token: business.max.ru -> Чат-боты -> Расширенные настройки.
# ---------------------------------------------------------------------------
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=id505030516451_bot
# REQUIRED whenever MAX_BOT_TOKEN is set — the webhook is public, and without a
# secret anyone who learns the URL could bind an arbitrary account to a pending
# confirmation session. Verified against the X-Max-Bot-Api-Secret header.
# MAX restricts the value to [A-Za-z0-9_-]{5,256}; generate with:
#   openssl rand -hex 32
MAX_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# SMTP (password reset + welcome mail). Optional as a group: without SMTP_HOST
# the mailer reports itself unconfigured and callers skip sending.
# SMTP_SECURE=true -> implicit TLS (465); false -> STARTTLS (587).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Voxly" <admin@getvoxly.ru>

# Optional provider integrations used by compose and runtime.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
MAX_BRIDGE_URL=http://max-bridge:3010
VOXLY_SERVICE_TOKEN=
REDIS_URL=redis://localhost:6379/1

ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_IS_TEST=true
ROBOKASSA_HASH_ALGO=SHA256
ROBOKASSA_TAX=none

# PostgreSQL connection pool tuning (optional; defaults are safe for local use).
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=10000
PGPOOL_CONNECT_TIMEOUT_MS=5000
PGAPPNAME=getvoxly-api

GEMINI_API_KEYS=
OPENAI_API_KEYS=
DEEPSEEK_API_KEYS=
GRAMJS_BRIDGE_URL=http://gramjs-bridge:3008

# -----------------------------------------------------------------------------
# Шлюз LLM (OpenAI-совместимый API)
# -----------------------------------------------------------------------------
# Один адрес и один ключ на все модели: шлюз сам маршрутизирует запрос к
# OpenAI/Anthropic/остальным. Отдельные ключи на провайдера означали бы столько
# же переменных, сколько моделей в каталоге.
#
# Задаются вместе: с одним из двух вызов упал бы 401 у провайдера, поэтому
# валидация окружения требует пару целиком. Без обеих база знаний отвечает
# 503 EMBEDDINGS_UNAVAILABLE, остальной API работает.
LLM_API_BASE_URL=https://example-gateway/v1
LLM_API_KEY=

# Модель эмбеддингов. Размерность обязана совпадать с типом vector(1536) в
# knowledge_base_chunks — смена модели требует миграции, иначе векторы в одной
# таблице станут несравнимыми и поиск будет возвращать мусор. Проверка
# размерности выполняется в рантайме.
LLM_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
