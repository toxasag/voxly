{
  "name": "getvoxly-backend",
  "version": "0.1.0",
  "private": true,
  "description": "GETVOXLY backend — Fastify 5 + PostgreSQL",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "migrate": "node-pg-migrate -d MIGRATION_DATABASE_URL -f migrate-config.cjs",
    "migrate:up": "node-pg-migrate -d MIGRATION_DATABASE_URL -f migrate-config.cjs up",
    "migrate:down": "node-pg-migrate -d MIGRATION_DATABASE_URL -f migrate-config.cjs down",
    "migrate:create": "node-pg-migrate -d MIGRATION_DATABASE_URL -f migrate-config.cjs create",
    "migrate:status": "node scripts/migrate-status.mjs",
    "migrate:baseline": "node-pg-migrate -d MIGRATION_DATABASE_URL -f migrate-config.cjs up --fake",
    "migrate:dry": "node-pg-migrate -d MIGRATION_DATABASE_URL -f migrate-config.cjs up --dry-run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "@types/ioredis": "^4.28.10",
    "argon2": "^0.41.1",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^6.0.0",
    "mammoth": "^1.12.1",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "6.9.16",
    "pdf-parse": "^1.1.4",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
