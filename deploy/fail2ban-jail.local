# Защита от подбора пароля SSH.
# 25 августа 2026 сервер лёг из-за 188 758 попыток входа с 916 адресов:
# sshd порождал процесс на каждую попытку, userspace перестал получать CPU,
# исходящий трафик (DNS, NTP) умирал при живом ядре.
#
# Пороги ослаблены 31 августа 2026 после того, как деплой забанил сам себя.
# Причина: rsync и docker-compose открывают соединения часто, лишние
# отбрасываются по MaxStartups, и каждое отбрасывание попадает в журнал как
# `Connection closed [preauth]` — фильтр sshd считает это неудачной попыткой.
# При maxretry = 4 рабочая машина уходила в бан на час за собственный деплой.
#
# Ослабление порогов почти не влияет на защищённость: пароли отключены
# (PasswordAuthentication no), подбирать нечего. fail2ban здесь снимает
# нагрузку с sshd, а не предотвращает вход.

[DEFAULT]
# backend=systemd: /var/log/auth.log на этой системе не ведётся,
# журнал доступен только через journald.
backend = systemd
# 10 минут вместо часа: случайно забанивший себя администратор не ждёт
# доступа к VNC-консоли, а брутфорс-бот за 10 минут не успевает создать
# нагрузку, из-за которой jail вводился.
bantime = 10m
findtime = 10m
# 10 вместо 4: деплой (rsync + сборка образов) открывает соединения пачками.
maxretry = 10
# Рабочая машина администратора. Без этой строки любой деплой рискует
# заблокировать себе доступ на середине выкладки.
#
# Адрес взят из журнала sshd (`Accepted publickey for root from ...`), а не из
# ifconfig.me: тот показывает адрес выхода HTTP-трафика, и он отличался
# (109.95.217.174 против 45.131.214.254). Внесённый по ifconfig.me адрес
# защиты не давал — банился фактический адрес SSH.
ignoreip = 127.0.0.1/8 ::1 45.131.214.254 109.95.217.174

[sshd]
enabled = true
port = ssh
# Нарастание срока отключено: при bantime = 10m оно давало бы сутки и
# больше за повторные срабатывания, то есть возвращало бы исходную проблему
# для администратора с динамическим адресом.
bantime.increment = false
