// Voxly Control Plane — Prisma Schema
// All billing, tenants, users, bots, referrals, analytics, AI wallet

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tenants & Users
// ============================================================

model Tenant {
  id                String         @id @default(cuid())
  slug              String         @unique
  portalHost        String         @unique // {slug}.getvoxly.ru
  twentyWorkspaceId String?        // set after provisioning
  twentyWorkspaceSlug String?      // subdomain for {slug}-crm
  twentyOwnerPasswordEncrypted String? // random Twenty credential for SSO, AES-256-GCM
  crmSubdomain      String?        // {slug}-crm
  status            TenantStatus   @default(trial)
  aiMarkupPercent   Int?           // override global markup for this tenant
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  users             TenantMember[]
  subscriptions     Subscription[]
  payments          Payment[]
  addons            Addon[]
  aiWallet          AiWallet?
  tenantBalance     TenantBalance?
  botInstances      BotInstance[]
  botProvisionReqs  BotProvisionRequest[]
  analyticsIntegr   AnalyticsIntegration[]
  trackingLinks     TrackingLink[]
  attributionSess   AttributionSession[]
  conversionEvents  ConversionEvent[]
  giftCampaigns     GiftCampaignConfig[]
  giftSubscribers   GiftSubscriber[]
  referralCode      ReferralCode?
  referralsMade     Referral[]     @relation("ReferrerTenant")
  referralReceived  Referral?      @relation("ReferredTenant")
  referralEarnings  ReferralEarning[]
  referralCampaigns ReferralCampaign[]
  referralCampaignExpenses ReferralCampaignExpense[]
  pricingOverrides  PricingOverride[]
  auditLogs         AuditLog[]
  broadcasts        Broadcast[]
  mailingStageRules MailingStageRule[]
  conversations     Conversation[]
  aiUsageLog        AiUsageLog[]
  aiAgents          AiAgent[]
  knowledgeFiles    AiKnowledgeFile[]
  knowledgeChunks   AiKnowledgeChunk[]
  salesExamples     AiSalesExample[]

  @@index([status])
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  role            UserRole   @default(member)
  firstName       String?
  lastName        String?
  telegramUserId  BigInt?    @unique // for Managed Bots linking
  isEmailVerified Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenantMembers   TenantMember[]
  auditLogs       AuditLog[]

  @@index([email])
}

model TenantMember {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      UserRole @default(member) // owner or member within tenant
  twentyPasswordEncrypted String?
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

// ============================================================
// Subscriptions & Payments
// ============================================================

model Subscription {
  id             String   @id @default(cuid())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  productCode    String   // crm_base, extra_seat, gift_bot, etc.
  periodMonths   Int      // 1, 3, 6, 12, 24
  seatsIncluded  Int      @default(10)
  extraSeats     Int      @default(0)
  startsAt       DateTime
  endsAt         DateTime
  status         String   @default("active") // active, expired, cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments       Payment[]

  @@index([tenantId])
  @@index([status])
  @@index([endsAt])
}

model Payment {
  id              String       @id @default(cuid())
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String?
  robokassaInvId  Int          @unique
  amount          Decimal      @db.Decimal(10, 2)
  status          String       @default("pending") // pending, paid, failed, refunded
  productCode     String
  periodMonths    Int?
  description     String
  idempotencyKey  String       @unique
  shpTenantId     String
  fiscalReceipt   Json?        // 54-ФЗ receipt data
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  referralEarnings ReferralEarning[]

  @@index([tenantId])
  @@index([status])
}

// ============================================================
// Add-ons (gift bot, AI, analytics per tenant)
// ============================================================

model Addon {
  id          String    @id @default(cuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  type        String    // gift_bot, ai_tg, ai_gramjs, ai_wa, analytics_*
  config      Json      // platform-specific config
  activeUntil DateTime
  status      String    @default("active") // active, expired, suspended
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  analyticsIntegr AnalyticsIntegration[]
  aiUsageLog      AiUsageLog[]
  botInstances    BotInstance[]

  @@unique([tenantId, type])
  @@index([tenantId])
  @@index([activeUntil])
}

// ============================================================
// AI Wallet & Usage
// ============================================================

model AiWallet {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String   @unique
  balanceRub Decimal  @db.Decimal(10, 2) @default(0)
  updatedAt  DateTime @updatedAt

  aiUsageLog AiUsageLog[]

  @@index([tenantId])
}

model AiUsageLog {
  id              String   @id @default(cuid())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String
  addon           Addon?   @relation(fields: [addonId], references: [id])
  addonId         String?
  aiAgent         AiAgent? @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  aiAgentId       String?
  aiWallet        AiWallet @relation(fields: [aiWalletId], references: [id])
  aiWalletId      String
  model           String   // gpt-4o, gpt-4o-mini, etc.
  tokens          Int      // total tokens (prompt + completion)
  providerCostRub Decimal  @db.Decimal(10, 4)
  markupPercent   Int
  chargedRub      Decimal  @db.Decimal(10, 4)
  requestType     String   // text, transcribe, vision
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([aiWalletId])
  @@index([aiAgentId])
  @@index([createdAt])
}

/// Tenant-scoped AI agent (prompt/settings). Orthogonal to channels.
/// Null assignment on bot/conversation = AI OFF (ADR-014).
model AiAgent {
  id           String   @id @default(cuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  name         String
  systemPrompt String?
  settings     Json?
  /// active | archived
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  defaultForBots   BotInstance[]       @relation("BotDefaultAiAgent")
  conversations    Conversation[]
  aiUsageLog       AiUsageLog[]
  knowledgeFiles   AiKnowledgeFile[]
  knowledgeChunks  AiKnowledgeChunk[]
  salesExamples    AiSalesExample[]

  @@index([tenantId])
  @@index([status])
}

/// Uploaded knowledge file for an agent (txt/md/pdf).
model AiKnowledgeFile {
  id             String   @id @default(cuid())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  aiAgent        AiAgent  @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  aiAgentId      String
  filename       String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  extractedChars Int      @default(0)
  /// processing | ready | failed
  status         String   @default("processing")
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chunks AiKnowledgeChunk[]

  @@index([tenantId])
  @@index([aiAgentId])
  @@index([status])
}

/// Embedded chunk of a knowledge file.
model AiKnowledgeChunk {
  id            String          @id @default(cuid())
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String
  aiAgent       AiAgent         @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  aiAgentId     String
  file          AiKnowledgeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId        String
  ordinal       Int
  content       String
  /// float[] embedding as JSON
  embedding     Json
  tokenEstimate Int             @default(0)
  createdAt     DateTime        @default(now())

  @@index([tenantId])
  @@index([aiAgentId])
  @@index([fileId])
}

/// Operator↔user pairs from successfully closed CRM deals (won stage).
model AiSalesExample {
  id              String   @id @default(cuid())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String
  aiAgent         AiAgent  @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  aiAgentId       String
  conversationId  String?
  opportunityId   String?
  userText        String
  operatorText    String
  embedding       Json
  sourceMessageId String   @unique
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([aiAgentId])
  @@index([opportunityId])
}

// ============================================================
// Tenant Balance (referral credits + manual admin credits)
// ============================================================

model TenantBalance {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String   @unique
  balanceRub Decimal  @db.Decimal(10, 2) @default(0)
  updatedAt  DateTime @updatedAt
}

// ============================================================
// Platform Settings (key-value)
// ============================================================

model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ============================================================
// Pricing Overrides (custom prices / free access per tenant)
// ============================================================

model PricingOverride {
  id              String   @id @default(cuid())
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String?  // null = global default override
  productCode     String
  customPriceRub  Decimal? @db.Decimal(10, 2)
  freeUntil       DateTime?
  aiMarkupPercent Int?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, productCode])
  @@index([productCode])
}

// ============================================================
// Bot Instances & Provisioning (Managed Bots)
// ============================================================

model BotInstance {
  id                String            @id @default(cuid())
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId          String
  managedBotUserId  BigInt?           @unique // telegram user_id of managed bot creator
  botUsername       String?           // TG @username OR WA Evolution slug (ascii)
  displayName       String?           // Human label (WA Cyrillic OK); UI prefers this over botUsername
  botTokenEncrypted String?           // AES-256: bot token OR GramJS StringSession
  webhookSecret     String            @default(cuid())
  provisionedVia    BotProvisionVia   @default(managed)
  botType           String            @default("gift") // gift, ai_tg, ai_gramjs, ai_wa
  status            String            @default("active") // active, inactive, suspended
  /// Telegram setMyDescription — shown when user opens bot link before /start (max 512)
  telegramDescription String?
  /// Telegram setMyShortDescription — profile / share blurb (max 120)
  telegramShortDescription String?
  addon             Addon?            @relation(fields: [addonId], references: [id])
  addonId           String?
  phoneNumberId     String?           // WhatsApp phone_number_id OR GramJS telegram user id
  /// Account-level default AI agent (nullable = AI off until conversation override or assign).
  defaultAiAgent    AiAgent?          @relation("BotDefaultAiAgent", fields: [defaultAiAgentId], references: [id], onDelete: SetNull)
  defaultAiAgentId  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  giftCampaigns     GiftCampaignConfig[]
  conversations     Conversation[]

  @@index([tenantId])
  @@index([status])
  @@index([defaultAiAgentId])
}

model BotProvisionRequest {
  id                String   @id @default(cuid())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId          String
  nonce             String   @unique
  suggestedUsername String?
  suggestedName     String?
  botType           String   @default("gift")
  status            String   @default("pending") // pending, confirmed, failed, expired
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([nonce])
}

// ============================================================
// Referral Program
// ============================================================

model ReferralCode {
  id           String   @id @default(cuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String   @unique
  code         String   @unique // e.g. ACME7X2K
  isActive     Boolean  @default(true)
  clicksCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Referral {
  id                 String    @id @default(cuid())
  referrerTenant     Tenant    @relation("ReferrerTenant", fields: [referrerTenantId], references: [id])
  referrerTenantId   String
  referredTenant     Tenant    @relation("ReferredTenant", fields: [referredTenantId], references: [id], onDelete: Cascade)
  referredTenantId   String    @unique
  /// Project/campaign link used at registration (null = main referral code)
  campaign           ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId         String?
  attributedAt       DateTime  @default(now())
  firstPaymentAt     DateTime?
  status             String    @default("attributed") // attributed, earned, cancelled
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  earnings           ReferralEarning[]

  @@index([referrerTenantId])
  @@index([campaignId])
  @@index([attributedAt])
  @@index([firstPaymentAt])
}

model ReferralRule {
  id              String          @id @default(cuid())
  type            ReferralRuleType
  value           Decimal         @db.Decimal(10, 2) // fixed amount or percentage
  durationMonths  Int?            // for percent_recurring
  productScope    String          @default("all") // all, crm
  isDefault       Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ReferralEarning {
  id              String    @id @default(cuid())
  referral        Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referralId      String
  payment         Payment?  @relation(fields: [paymentId], references: [id])
  paymentId       String?
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String // the referrer tenant
  amountRub       Decimal   @db.Decimal(10, 2)
  ruleApplied     String
  creditedAt      DateTime  @default(now())

  @@index([tenantId])
  @@index([referralId])
}

/// Per-project referral link (e.g. different Telegram channels)
model ReferralCampaign {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  name        String
  code        String   @unique
  clicksCount Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  referrals   Referral[]
  expenses    ReferralCampaignExpense[]

  @@index([tenantId])
}

model ReferralCampaignExpense {
  id         String           @id @default(cuid())
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  campaign   ReferralCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  amountRub  Decimal          @db.Decimal(10, 2)
  note       String?
  spentAt    DateTime         @default(now())
  createdAt  DateTime         @default(now())

  @@index([tenantId])
  @@index([campaignId])
  @@index([spentAt])
}

// ============================================================
// Analytics Integrations & Conversion Tracking
// ============================================================

model AnalyticsIntegration {
  id                 String             @id @default(cuid())
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId           String
  platform           AnalyticsPlatform  // metrika, ga4, facebook, vk
  credentialsEncrypted String?          // AES-256 encrypted JSON
  isActive           Boolean            @default(false)
  addon              Addon?             @relation(fields: [addonId], references: [id])
  addonId            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([tenantId, platform])
  @@index([tenantId])
}

model AttributionSession {
  id              String   @id @default(cuid())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String
  clickId         String   @unique
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  yclid           String?
  ymUid           String?
  fbp             String?
  fbc             String?
  gclid           String?
  rbClickid       String?
  telegramUserId  BigInt?
  creativeTag     String?
  postId          String?
  landedAt        DateTime @default(now())

  conversionEvents ConversionEvent[]

  @@index([tenantId])
  @@index([clickId])
}

model ConversionEvent {
  id              String   @id @default(cuid())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String
  goalName        String   // bot_start, subscription_verified, etc.
  subscriberId    String?  // telegram user id or campaign id (promo_click)
  botInstanceId   String?  // gift / AI bot that produced the goal
  campaignId      String?  // GiftCampaignConfig id when applicable
  attribution     AttributionSession? @relation(fields: [attributionId], references: [id])
  attributionId   String?
  platformsStatus Json     // { metrika: "sent", facebook: "failed", ... }
  status          String   @default("dispatched") // dispatched, sent, partial, failed
  payload         Json?
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([goalName])
  @@index([createdAt])
  @@index([campaignId])
  @@index([botInstanceId])
  @@index([tenantId, goalName])
}

model TrackingLink {
  id           String   @id @default(cuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  shortCode    String   @unique
  targetUrl    String?  // if null, redirect to bot start
  utmParams    Json?
  creativeTag  String?
  postId       String?
  clicksCount  Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([shortCode])
}

// ============================================================
// Gift Campaign Config (stored in control plane, synced to Twenty)
// ============================================================

model GiftCampaignConfig {
  id            String       @id @default(cuid())
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String
  botInstance   BotInstance  @relation(fields: [botInstanceId], references: [id])
  botInstanceId String
  /// Human name of the project/campaign (e.g. "Подарок июль")
  name          String       @default("Проект")
  channelId     String       // Telegram channel ID
  channelUsername String?
  giftFileUrl   String?
  funnelJson    Json         // step definitions with timeouts, goals
  promoPost     Json?        // channel promo: text, mediaType photo|video, mediaUrl, button, clickCount
  analyticsConfig Json?      // goal mappings per platform
  /// Off = paused: no new /start via bare link; deep-link g_{id} also requires isActive
  isActive      Boolean      @default(true)
  /// Optional window: scheduler flips isActive (and enforces one active project per bot)
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subscribers   GiftSubscriber[]

  @@index([tenantId])
  @@index([botInstanceId, isActive])
  @@index([scheduledStartAt])
  @@index([scheduledEndAt])
}

/// Subscriber state for gift-bot funnels / broadcasts (synced to Twenty CRM)
model GiftSubscriber {
  id                 String             @id @default(cuid())
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId           String
  campaign           GiftCampaignConfig @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId         String
  botInstanceId      String
  telegramId         String
  username           String?
  firstName          String?
  phone              String?
  subscribed         Boolean            @default(false)
  giftDelivered      Boolean            @default(false)
  funnelPhase        String             @default("started") // started, awaiting_sub, gifted, not_gifted
  twentyPersonId     String?
  twentyOpportunityId String?
  conversationId     String?
  lastMessageAt      DateTime?
  /// Last bot mailing that reached this subscriber (effectiveness attribution).
  lastMailingBroadcastId String?
  lastMailingAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([campaignId, telegramId])
  @@index([tenantId])
  @@index([botInstanceId])
  @@index([giftDelivered])
  @@index([subscribed])
  @@index([twentyOpportunityId])
  @@index([twentyPersonId])
  @@index([lastMailingAt])
}

model Broadcast {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  status      String   @default("draft") // draft, scheduled, sending, sent, failed
  scheduledAt DateTime?
  sentCount   Int      @default(0)
  totalCount  Int      @default(0)
  messageJson Json     // text, media, buttons
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

/// Auto-send when Opportunity enters a pipeline stage (in-CRM «По этапу сделки»).
model MailingStageRule {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  botId      String
  channel    String   @default("gift") // gift | gramjs | wa
  name       String   @default("")
  stageValue String
  text       String
  mediaUrl   String?
  mediaType  String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, stageValue, enabled])
}

// ============================================================
// Conversations & Chat Messages (AI agents)
// ============================================================

model Conversation {
  id              String   @id @default(cuid())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String
  botInstance     BotInstance? @relation(fields: [botInstanceId], references: [id])
  botInstanceId   String?
  platform        String   // telegram, whatsapp
  platformUserId  String
  platformUsername String?
  platformFirstName String?
  status          String   @default("open") // open, waiting_for_human, resolved, closed
  /// Preferred: ai | human. Legacy gift/portal may use bot (= ai).
  /// Mode alone does NOT enable AI — requires AiAgent assignment (ADR-014).
  mode            String   @default("ai")
  /// Auto or manual pause: AI silent until this time (unless aiDisabled).
  pausedUntil     DateTime?
  /// Full disable until manually re-enabled (no auto-resume).
  aiDisabled      Boolean  @default(false)
  /// e.g. telegram_business, telegram_private, telegram_gramjs, whatsapp
  channel         String?
  businessConnectionId String?
  /// Chat-level agent override; null → fall back to BotInstance.defaultAiAgentId; both null = AI off.
  aiAgent         AiAgent? @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  aiAgentId       String?
  /// Twenty CRM Person / Opportunity linked on first inbound (AI leads)
  twentyPersonId       String?
  twentyOpportunityId  String?
  /// Ambiguous Person dedupe → manual review in portal
  needsReview          Boolean  @default(false)
  /// Set after won-deal sales examples were ingested for this conversation
  salesLearnedAt       DateTime?
  /// CRM operator last opened this thread in Twenty «Чат» (unread = user msgs after).
  lastOperatorReadAt   DateTime?
  /// Last mailing/broadcast that reached this peer (effectiveness attribution).
  lastMailingBroadcastId String?
  lastMailingAt          DateTime?
  lastAiMessageAt DateTime?
  assignedToUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages        ChatMessage[]

  @@index([tenantId])
  @@index([botInstanceId])
  @@index([status])
  @@index([platformUserId])
  @@index([businessConnectionId])
  @@index([aiDisabled])
  @@index([needsReview])
  @@index([twentyPersonId])
  @@index([twentyOpportunityId])
  @@index([aiAgentId])
  @@index([lastMailingAt])
}

model ChatMessage {
  id              String   @id @default(cuid())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId  String
  role            String   // user, assistant, system, operator
  content         String
  /// Telegram media: [{ type, fileId, fileUniqueId?, fileName?, mimeType?, fileSize? }]
  attachments     Json?
  externalMessageId String? // Telegram/WhatsApp message ID
  /// sent | delivered | read | failed — mailing/outbound receipts (Phase 2)
  deliveryStatus  String?
  deliveredAt     DateTime?
  readAt          DateTime?
  tokensUsed      Int?
  modelUsed       String?
  providerCostRub Decimal? @db.Decimal(10, 4)
  chargedRub      Decimal? @db.Decimal(10, 4)
  sentAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([conversationId])
  @@index([role])
  @@index([externalMessageId])
  @@index([deliveryStatus])
}

/// Per-recipient delivery for channel mailings (GramJS / WA).
model BroadcastRecipient {
  id               String   @id @default(cuid())
  broadcastId      String
  conversationId   String?
  giftSubscriberId String?
  externalMessageId String?
  status           String   @default("pending") // pending | sent | delivered | read | failed
  error            String?
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([broadcastId])
  @@index([conversationId])
  @@index([externalMessageId])
  @@index([status])
}

// ============================================================
// Shared Telegram audience / overlap graph (platform SoT)
// See docs/specs/TG-AUDIENCE-GRAPH-TZ.md — no message text stored.
// ============================================================

model TelegramPeer {
  id        String   @id @default(cuid())
  /// Telegram peer id as string (channel / chat / user / bot)
  peerId    String   @unique
  /// channel | group | bot | user
  peerType  String
  username  String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([peerType])
  @@index([username])
}

model TelegramSighting {
  id                   String   @id @default(cuid())
  telegramUserId       String
  peerId               String
  /// member | seen_in | admin
  relation             String
  firstSeenAt          DateTime @default(now())
  lastSeenAt           DateTime @default(now())
  sourceTenantId       String
  sourceBotInstanceId  String?
  confidence           Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([telegramUserId, peerId, relation])
  @@index([telegramUserId])
  @@index([peerId])
  @@index([sourceTenantId])
}

// ============================================================
// Audit Log
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId  String?
  actor     User?    @relation(fields: [actorUserId], references: [id])
  actorUserId String?
  action    String   // pricing_override, free_access, suspend, impersonate, etc.
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actorUserId])
  @@index([action])
}

