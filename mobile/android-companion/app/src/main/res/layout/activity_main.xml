<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/voxly_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GETVOXLY Caller ID"
            android:textColor="@color/voxly_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Мобильный компаньон для синхронизации звонков SIM-карты с CRM"
            android:textColor="@color/voxly_text_secondary"
            android:textSize="13sp" />

        <!-- Блок подключения к CRM -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. Подключение к серверу"
            android:textColor="@color/voxly_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="https://api.getvoxly.ru"
            android:inputType="textUri"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etApiToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="API токен сотрудника (Bearer JWT)"
            android:inputType="textPassword"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/voxly_primary"
            android:text="Сохранить и проверить связь"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Статус: ожидание настройки"
            android:textColor="@color/voxly_text_secondary"
            android:textSize="12sp" />

        <!-- Блок разрешений системы -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. Системные разрешения Android"
            android:textColor="@color/voxly_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGrantOverlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Разрешить показ поверх окон" />

        <Button
            android:id="@+id/btnGrantScreening"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Назначить определителем номера (АОН)" />

        <Button
            android:id="@+id/btnGrantBattery"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Отключить оптимизацию батареи" />

        <!-- Тест -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Проверка работы"
            android:textColor="@color/voxly_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTestOverlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Показать тестовую карточку Caller ID" />

    </LinearLayout>
</ScrollView>
