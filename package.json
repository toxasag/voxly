{
  "name": "voxly",
  "private": true,
  "version": "0.1.0",
  "description": "Voxly — SaaS CRM platform built on Twenty CRM with Telegram bots, AI agents, and analytics",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "pnpm --filter @voxly/saas-portal test:e2e",
    "verify": "pnpm typecheck && pnpm test && pnpm --filter @voxly/saas-portal lint",
    "report:unit-econ": "tsx scripts/unit-econ-report.ts",
    "perf:seed": "tsx scripts/perf-seed-and-measure.ts",
    "db:generate": "pnpm --filter @voxly/db prisma:generate",
    "db:migrate": "pnpm --filter @voxly/db prisma:migrate",
    "db:push": "pnpm --filter @voxly/db prisma:push",
    "db:studio": "pnpm --filter @voxly/db prisma:studio",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.11.1"
    }
  },
  "dependencies": {
    "@fastify/cookie": "^9.0.0"
  }
}
