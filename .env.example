# ============================================================
# Voxly — Environment Variables (copy to .env and fill in)
# ============================================================

# --- Domain ---
VOXLY_DOMAIN=getvoxly.ru

# --- Control Plane DB (PostgreSQL) ---
DATABASE_URL=postgresql://voxly:voxly_pass@localhost:5433/voxly_control?schema=public

# --- Twenty DB (PostgreSQL) ---
TWENTY_DATABASE_URL=postgresql://twenty:twenty_pass@localhost:5434/twenty?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Twenty API (for workspace provisioning via GraphQL) ---
TWENTY_API_URL=http://twenty-server:3000/graphql
TWENTY_API_KEY=changeme-twenty-api-key

# --- Auth ---
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# --- Encryption (AES-256 for bot tokens, sessions, API keys) ---
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=change-this-to-a-32-byte-hex-key

# --- Robokassa ---
ROBOKASSA_LOGIN=your-merchant-login
ROBOKASSA_PASSWORD1=your-password-1
ROBOKASSA_PASSWORD2=your-password-2
ROBOKASSA_IS_TEST=1

# --- Telegram Manager Bot ---
# Create via @BotFather, enable Bot Management Mode
TELEGRAM_MANAGER_BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_MANAGER_BOT_USERNAME=VoxlyManagerBot

# --- OpenAI (for AI agents, Phase 3+) ---
OPENAI_API_KEY=sk-...

# --- SMTP (welcome emails, notifications) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=noreply@getvoxly.ru
SMTP_PASS=your-smtp-password
SMTP_FROM="Voxly <noreply@getvoxly.ru>"

# --- Portal ---
PORTAL_PORT=3001
API_PORT=3002

# --- AI Markup (default 50%) ---
AI_MARKUP_PERCENT=50
AI_TOPUP_MIN_RUB=500

# --- Super-admin (for initial seed) ---
SUPERADMIN_EMAIL=admin@getvoxly.ru
SUPERADMIN_PASSWORD=changeme-immediately

# --- WhatsApp Cloud API (Phase 4) ---
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token

# --- Docker Compose passwords ---
POSTGRES_CONTROL_PASSWORD=voxly_pass
POSTGRES_TWENTY_PASSWORD=twenty_pass
TWENTY_JWT_SECRET=change-twenty-jwt-secret
