# ============================================================
# Voxly — Environment Variables (copy to .env and fill in)
# ============================================================

# --- Domain ---
VOXLY_DOMAIN=getvoxly.ru

# --- Control Plane DB (PostgreSQL) ---
DATABASE_URL=postgresql://voxly:voxly_pass@localhost:5433/voxly_control?schema=public

# --- Twenty DB (PostgreSQL) ---
TWENTY_DATABASE_URL=postgresql://twenty:twenty_pass@localhost:5434/twenty?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Twenty API (for workspace provisioning via GraphQL) ---
TWENTY_API_URL=http://twenty-server:3000/graphql
TWENTY_API_KEY=changeme-twenty-api-key
# Browser-facing Twenty URL. Local multiworkspace: http://localhost:3007
# (SSO opens http://{slug}.localhost:3007 — Chromium resolves *.localhost).
# Avoid lvh.me (blank SPA) and bare host without subdomain (/welcome).
TWENTY_SERVER_URL=https://app.getvoxly.ru
# Apps SDK logic functions (production image defaults to DISABLED without this)
LOGIC_FUNCTION_TYPE=LOCAL

# --- Auth ---
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# --- Encryption (AES-256 for bot tokens, sessions, API keys) ---
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=change-this-to-a-32-byte-hex-key

# --- Robokassa ---
ROBOKASSA_LOGIN=your-merchant-login
ROBOKASSA_PASSWORD1=your-password-1
ROBOKASSA_PASSWORD2=your-password-2
ROBOKASSA_IS_TEST=1

# --- Telegram Manager Bot ---
# Create via @BotFather, enable Bot Management Mode
TELEGRAM_MANAGER_BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_MANAGER_BOT_USERNAME=VoxlyGiftbot
# Local gift-bot: long-poll instead of public HTTPS webhook
GIFT_BOT_USE_POLLING=true
GIFT_BOT_WEBHOOK_BASE_URL=http://localhost:3004

# --- OpenRouter / AI agents (Phase 1 TG Business) ---
# Prefer OpenRouter; OPENAI_API_KEY kept as fallback for older workers.
OPENROUTER_API_KEY=
OPENAI_API_KEY=sk-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# USD→RUB for AI provider cost (OpenRouter credits ≈ USD). PlatformSetting `usd_rub_rate` is fallback.
USD_RUB_RATE=90
AI_CHAT_MODEL=google/gemini-2.5-flash
AI_CHAT_MODEL_FALLBACK=openai/gpt-4o
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_ASR_MODEL=openai/whisper-1
# Internal docker DNS used by gift-bot-worker to forward ai_tg webhooks
AI_TELEGRAM_WORKER_URL=http://ai-telegram-worker:3005
# Quiet window after last user message before AI replies (TG Business + WhatsApp + GramJS)
AI_INBOUND_DEBOUNCE_MS=6000

# --- GramJS bridge (personal Telegram; compose profile `gramjs`) ---
# Platform api_id/api_hash from https://my.telegram.org (not client-supplied)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional phone hint for QR help text (local .env only)
TELEGRAM_PHONE=
GRAMJS_BRIDGE_PORT=3008
# saas-api → bridge (docker DNS; do not expose bridge publicly)
GRAMJS_BRIDGE_URL=http://gramjs-bridge:3008

# --- SMTP (welcome emails, notifications) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=noreply@getvoxly.ru
SMTP_PASS=your-smtp-password
SMTP_FROM="Voxly <noreply@getvoxly.ru>"

# --- Portal ---
PORTAL_PORT=3001
API_PORT=3002

# Browser-facing API URL baked into Twenty deal-chat inject (local override in compose)
VOXLY_API_URL=http://localhost:3002
VOXLY_CABINET_URL=http://localhost:3001/dashboard
# saas-api → Twenty app var VOXLY_API_URL (logic functions; docker DNS)
VOXLY_CHAT_API_URL=http://saas-api:3002
# Built by saas-api image (`yarn twenty dev:build --tarball`); override/mount for local
VOXLY_CRM_CHAT_TARBALL=/voxly/assets/voxly-crm-chat.tgz
# Twenty Postgres (customDomain SQL fallback — GraphQL needs Cloudflare)
TWENTY_DATABASE_URL=postgresql://twenty:twenty_pass@postgres-twenty:5432/twenty
# Shared secret: Twenty LOCAL logic functions → saas-api CRM chat (Bearer).
# Must be set on saas-api AND twenty-server/twenty-worker (compose injects both).
VOXLY_SERVICE_TOKEN=change-me-voxly-service-token

# --- AI Markup (default 50%) ---
AI_MARKUP_PERCENT=50
AI_TOPUP_MIN_RUB=500

# --- Super-admin (for initial seed) ---
SUPERADMIN_EMAIL=admin@getvoxly.ru
SUPERADMIN_PASSWORD=changeme-immediately

# --- WhatsApp via Evolution API (Phase 2 / ADR-014) ---
# One stack only: Evolution (Baileys QR). Meta Cloud API draft retired.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change-me-evolution-api-key
EVOLUTION_SERVER_URL=http://evolution-api:8080
# Baileys WhatsApp Web version — must stay current or QR stays count:0 (INC-035)
CONFIG_SESSION_PHONE_VERSION=2.3000.1043705293
AI_WHATSAPP_WORKER_URL=http://ai-whatsapp-worker:3006
AI_WHATSAPP_WEBHOOK_URL=http://ai-whatsapp-worker:3006/webhook/evolution
# Create DB once: docker compose exec postgres-control psql -U voxly -d postgres -c "CREATE DATABASE evolution;"
# Start Evolution: docker compose --profile whatsapp up -d evolution-api
# Image: voxly-evolution-api:v2.3.7-lid (compose). Baileys lidMapping / remoteJidAlt.
# Avoid v2.4.0 until Evolution Foundation licensing is accepted. See Dockerfile.
# Dangerous opt-in: invent PN by matching Contact avatar CDN fingerprint (wrong-number risk).
# WA_LID_AVATAR_PHONE_MATCH=1

# Legacy Meta Cloud API keys (unused — kept for reference only)
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# --- Docker Compose passwords ---
POSTGRES_CONTROL_PASSWORD=voxly_pass
POSTGRES_TWENTY_PASSWORD=twenty_pass
TWENTY_JWT_SECRET=change-twenty-jwt-secret
