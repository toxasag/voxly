# =============================================================================
# GETVOXLY — production compose secrets (шаблон)
#
# Скопировать в .env рядом с docker-compose.yml и заполнить своими значениями.
# Файл .env в репозиторий не попадает (см. .gitignore).
#
# Генерация значений:
#   JWT_SECRET:        openssl rand -base64 48
#   POSTGRES_PASSWORD: openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 28
#   APP_DB_PASSWORD:   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 28
# =============================================================================

# Пароль владельца схемы (роль getvoxly). Используется только для миграций и
# первичной инициализации БД.
POSTGRES_PASSWORD=

# Пароль непривилегированной роли app_user, которой подключается backend.
# Именно на ней работают RLS-политики: владелец схемы их обходит.
APP_DB_PASSWORD=

# Ключ подписи access/refresh токенов. Минимум 32 символа, иначе backend не
# стартует в production (см. backend/src/config/env.ts).
JWT_SECRET=

# Токен бота, доставляющего коды подтверждения (@GetVoxlybot).
# Выдаётся @BotFather.
TELEGRAM_AUTH_BOT_TOKEN=

# Секрет webhook: openssl rand -hex 24
# Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token, а backend
# сверяет. Без него любой, кто узнает URL, мог бы прислать поддельное
# обновление и привязать произвольный chat_id к сессии подтверждения.
TELEGRAM_WEBHOOK_SECRET=

# Пароль SMTP-аккаунта (SMTP.bz). Остальные параметры почты заданы в
# docker-compose.yml: они не секретны.
SMTP_PASS=
