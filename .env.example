# =============================================================================
# GETVOXLY — production compose secrets (шаблон)
#
# Скопировать в .env рядом с docker-compose.yml и заполнить своими значениями.
# Файл .env в репозиторий не попадает (см. .gitignore).
#
# Генерация значений:
#   JWT_SECRET:        openssl rand -base64 48
#   POSTGRES_PASSWORD: openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 28
#   APP_DB_PASSWORD:   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 28
# =============================================================================

# Пароль владельца схемы (роль getvoxly). Используется только для миграций и
# первичной инициализации БД.
POSTGRES_PASSWORD=

# Ключ подписи access/refresh токенов. Минимум 32 символа в production.
JWT_SECRET=

# Пароль непривилегированной роли app_user, которой подключается backend.
# Именно на ней работают RLS-политики: владелец схемы их обходит.
APP_DB_PASSWORD=

EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_SERVER_URL=http://evolution-api:8080

# MAX bridge and internal service authentication.
MAX_BRIDGE_URL=http://max-bridge:3010
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
VOXLY_SERVICE_TOKEN=

# Redis 7 used by ioredis and BullMQ. The database number is part of the URL.
REDIS_URL=redis://localhost:6379/1

# Public URLs and frontend build-time API target.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# LLM gateway and provider key pools. Leave blank to disable optional providers.
LLM_API_BASE_URL=https://example-gateway/v1
LLM_API_KEY=
LLM_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
GEMINI_API_KEYS=
OPENAI_API_KEYS=
DEEPSEEK_API_KEYS=

# Optional PostgreSQL pool settings.
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=10000
PGPOOL_CONNECT_TIMEOUT_MS=5000
PGAPPNAME=getvoxly-api

# -----------------------------------------------------------------------------
# Telegram bot delivery
# -----------------------------------------------------------------------------
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_BOT_USERNAME=GetVoxlybot

# Секрет webhook: openssl rand -hex 24
# Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token, а backend
# сверяет. Без него любой, кто узнает URL, мог бы прислать поддельное
# обновление и привязать произвольный chat_id к сессии подтверждения.
TELEGRAM_WEBHOOK_SECRET=

# Секрет Evolution API webhook: openssl rand -hex 32
# Передаётся Evolution API в заголовке x-evolution-webhook-secret.
# Реальное значение хранится только в production `.env` на VPS и не коммитится.
EVOLUTION_WEBHOOK_SECRET=

# Пароль SMTP-аккаунта (SMTP.bz). Остальные параметры почты заданы в
# docker-compose.yml: они не секретны.
SMTP_PASS=
